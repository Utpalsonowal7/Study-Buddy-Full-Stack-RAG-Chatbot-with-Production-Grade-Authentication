# Copy to .env for local development. Never commit .env or real credentials.
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/study_buddy
REDIS_URL=redis://127.0.0.1:6379/0

# Gemini Developer API (Google AI Studio). Placeholders return HTTP 503.
RAG_API_KEY=replace_me
RAG_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RAG_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_API_KEY / GEMINI_API_BASE_URL are also accepted aliases.
# RAG_API_* values take precedence if both naming styles are set.
# The existing pgvector model stores exactly 3072 dimensions.
RAG_CHAT_MODEL=gemini-3.1-flash-lite

# Cloudinary account settings; original files use authenticated raw storage.
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Set separate, strong signing keys in production. The cloud start helper
# generates temporary development keys automatically when none are supplied.
JWT_ACCESS_TOKEN_SECRECT=replace_me_with_a_random_signing_key
JWT_REFRESH_TOKEN_SECRET=replace_me_with_a_different_random_signing_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
# COOKIE_SECURE=false is only for local HTTP. Set true with HTTPS in production.

# Optional email and OAuth settings (not needed for document/chat endpoints).
BRAVO_API_KEY=replace_me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PROVIDER_URI=https://www.googleapis.com/oauth2/v2/userinfo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_AUTH_URI=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URI=https://github.com/login/oauth/access_token
GITHUB_USER_URI=https://api.github.com/user
GITHUB_USER_EMAILS_URI=https://api.github.com/user/emails
FRONTEND_URL=http://localhost:3000
